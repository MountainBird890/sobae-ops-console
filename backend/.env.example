# Supabase project used for Auth: verifying the console login token and inviting staff.
# This is the CONSOLE's own Auth project (SOBAE-WORKS-CONSOLE-STAGING), NOT the Sobae_Works
# business-data project that DATABASE_URL points at. SUPABASE_URL must be the same project as the
# frontend's VITE_SUPABASE_URL, and SUPABASE_SECRET_KEY must be that project's secret key; otherwise
# every request fails with 401 "Invalid or expired token".
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Direct Postgres connection (postgres.js) as the sobae_ops_executor role.
# Role/objects defined in sql/ — not yet applied to any real database.
DATABASE_URL=

# Comma-separated list of allowed frontend origins for CORS on /api/*.
# e.g. http://localhost:5173 for local dev. Empty/unset = no origin allowed.
ALLOWED_ORIGIN=

# Frontend origin used to build the Supabase invite email's redirect link
# (POST /api/staff/invite). e.g. http://localhost:5173 for local dev.
FRONTEND_URL=
