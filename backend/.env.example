# Supabase project (used for Auth admin operations, e.g. inviting the initial admin)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection as the sobae_ops_executor role.
# Connection string only — the role/DB objects themselves (sql/) don't exist yet.
DATABASE_URL=

# Comma-separated list of allowed frontend origins for CORS on /api/*.
# e.g. http://localhost:5173 for local dev. Empty/unset = no origin allowed.
ALLOWED_ORIGIN=
